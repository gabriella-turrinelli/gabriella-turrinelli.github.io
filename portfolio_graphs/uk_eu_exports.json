{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Total Fertility Rate, Republic of Korea",
  "data": {
    "url": "https://api.worldbank.org/v2/country/gbr;eu/indicator/NE.EXP.GNFS.ZS?format=json&per_page=1000",
    "format": {"property": "[1]"}
  },
  "transform": [{"filter": "datum.value != null"}],
  "mark": "line",
  "title": {
    "text": "Reliance on Exports in the Uk versus EU",
    "subtitle": "Exports of goods and services, % of GDP"
  },
  "height": 300,
  "width": 500,
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": "",
      "axis": {"grid": false},
      "scale": {"nice": false}
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "title": "Exports, % of GDP"
    },
    "color": {
      "field": "country.value",
      "type": "nominal",
      "title": "",
      "scale": {"range": ["#0033cc", "#3399ff"]},
      "legend": {"orient": "bottom", "titleAnchor": "middle"}
    }
  },
  "config": {
    "legend": {"orient": "bottom", "layout": {"bottom": {"anchor": "middle"}}}
  }
}